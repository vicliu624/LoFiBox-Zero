#!/bin/sh
set -eu

if [ "$(dpkg-query -W -f='${db:Status-Status}' lofibox-cardputer-zero 2>/dev/null || true)" = installed ]; then
    command=/usr/bin/lofibox-cardputer-zero
    private_dir=/usr/lib/lofibox-cardputer-zero
    test -x "$private_dir/lofibox_zero_device"
    test -x "$private_dir/lofibox-applaunch"
    test -f /usr/share/APPLaunch/applications/lofibox-cardputer-zero.desktop
    test -f /usr/share/APPLaunch/share/images/lofibox-cardputer-zero.png
    test ! -e /usr/bin/lofibox-wayland
    desktop-file-validate /usr/share/APPLaunch/applications/lofibox-cardputer-zero.desktop
else
    command=/usr/bin/lofibox
    private_dir=/usr/lib/lofibox
    test -x /usr/bin/lofibox-wayland
    test ! -e "$private_dir/lofibox_zero_device"
    desktop-file-validate /usr/share/applications/io.github.vicliu624.lofibox.desktop
    appstreamcli validate --no-net /usr/share/metainfo/io.github.vicliu624.lofibox.metainfo.xml
fi
test -x "$command"
test -x "$command-tui"
test -f "$private_dir/tag_writer.py"
test -f "$private_dir/remote_media_tool.py"
test -x "$private_dir/lofibox-mp3-decoder"
if "$private_dir/lofibox-mp3-decoder" >/dev/null 2>&1; then
    exit 1
else
    test "$?" -eq 2
fi
python3 - <<'PY'
import mutagen
PY

"$command" --help >/dev/null
"$command" --version >/dev/null
test ! -e /usr/bin/lofibox-x11
"$command-tui" --help >/dev/null
