[Desktop Entry]
Type=Application
Name=LoFiBox
GenericName=Music Player
Comment=Compact music player
Exec=/usr/lib/lofibox-cardputer-zero/lofibox-applaunch
Icon=/usr/share/APPLaunch/share/images/lofibox-cardputer-zero.png
Terminal=false
Categories=AudioVideo;Audio;Player;Music;
Keywords=music;audio;player;lofi;
StartupNotify=true
StartupWMClass=lofibox
X-Zero-AppId=io.github.vicliu624.lofibox
